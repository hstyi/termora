/* Termora Light / FlatLaf Light；主题配色由 main.cpp 中的 palette 提供。 */

/* =================== QTreeView Begin =================== */
QTreeView {
    border: none;
    outline: none;
    background-color: palette(base);
    /* 整行选中背景已由 TreeView 绘制，展开箭头不再单独填充选中背景。 */
    show-decoration-selected: 0;
}

QTreeView::item {
    height: 21px;
    padding: 0px 4px;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/icons/chevronRight.svg);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/icons/chevronDown.svg);
}

/* IDEA's 16px checkbox, scoped to the local changes tree. */
QTreeView::indicator {
    width: 12px;
    height: 12px;
    border: 1px solid palette(dark);
    border-radius: 3px;
    background-color: palette(base);
    image: none;
}

QTreeView::indicator:checked,
QTreeView::indicator:indeterminate {
    background-color: palette(highlight);
    border-color: palette(highlight);
}

QTreeView::indicator:checked {
    image: url(:/icons/checked-white.svg);
}

QTreeView::indicator:indeterminate {
    image: url(:/icons/indeterminate-white.svg);
}

QTreeView::indicator:disabled {
    background-color: palette(light);
    border-color: palette(midlight);
}

QTreeView::indicator:checked:disabled {
    image: url(:/icons/checked-disabled.svg);
}

QTreeView::indicator:indeterminate:disabled {
    image: url(:/icons/indeterminate-disabled.svg);
}
/* =================== QTreeView  End  =================== */




/* =================== QPlainTextEdit Begin =================== */
QPlainTextEdit {
    border: none;
    outline: none;
}
/* =================== QPlainTextEdit  End  =================== */




/* =================== QTableView Begin =================== */
QTableView {
    border: 1px solid palette(mid);
    outline: none;
    background-color: palette(base);
    color: palette(text);
    qproperty-showGrid: false;
    border-radius: 4px;
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
}

QTableView::item {
    border: none;
    border-right: 1px solid #ECECEC;
    border-bottom: 1px solid #ECECEC;
    padding: 0px 4px;
}

/* 左侧没有 cell 边框；最后一列也不再叠加右边框，只保留 Table 外框。 */
QTableView::item:last,
QTableView::item:only-one {
    border-right: none;
}

QTableView::item:selected {
    background-color: palette(highlight);
    color: palette(highlighted-text);
    border-color: rgba(255, 255, 255, 30);
}

QTableView::item:selected:!active {
    background-color: palette(midlight);
    color: palette(text);
}

QTableView QHeaderView {
    background-color: transparent;
    color: palette(window-text);
}

QTableView QHeaderView::section {
    padding: 0px 6px;
    border: none;
    border-right: 1px solid #E4E4E4;
    border-bottom: 1px solid #E4E4E4;
    background-color: palette(window);
    color: palette(window-text);
}

QTableView QHeaderView::section:last,
QTableView QHeaderView::section:only-one {
    border-right: none;
    border-top-right-radius: 3px;
}

QTableView QHeaderView::section:first,
QTableView QHeaderView::section:only-one {
    border-top-left-radius: 3px;
}

QTableView QTableCornerButton::section {
    border: none;
    border-right: 1px solid #E4E4E4;
    border-bottom: 1px solid #E4E4E4;
    background-color: palette(window);
}
/* =================== QTableView  End  =================== */




/* =================== QMenu Begin =================== */
QMenu {
    padding: 4px;
    background-color: palette(base);
    border-radius: 4px;
    border: 1px solid palette(mid);
    icon-size: 16px;
}

QMenu::item {
    color: palette(window-text);
}

QMenu::item {
	margin: 1px 0;
	padding: 0 12px 0 8px;
	height: 21px;
	min-width: 110px;
	icon-size: 16px;
	border-radius: 4px;
	background-color: transparent;
}

/* 与 TreeView 的活动选中样式一致，悬停和键盘导航使用同一颜色。 */
QMenu::item:enabled:hover,
QMenu::item:enabled:selected {
    background-color: palette(highlight);
    color: palette(highlighted-text);
}

QMenu::item:disabled {
    color: palette(dark);
}

/* 分隔线 */
QMenu::separator {
    height: 1px;
    background-color: palette(midlight);
    margin: 2px 4px;
}

/* 子菜单箭头 */
QMenu::right-arrow {
    image: url(:/icons/chevronRight.svg);
    padding-right: 4px;
}

/* 可勾选项的勾选标记 */
QMenu::indicator {
    left: 6px;
    width: 16px;
    height: 16px;
}

QMenu::icon {
    left: 6px;
}

QMenu::indicator:non-exclusive:unchecked,
QMenu::indicator:exclusive:unchecked {
    image: none;
}
/* =================== QMenu  End  =================== */




/* =================== QListView Begin =================== */
QListView,
QComboBox QAbstractItemView {
	outline: none;
	background-color: palette(base);
    border-radius: 6px;
    border: 1px solid palette(mid);
	padding: 4px;
}

QListView::item,
QComboBox QAbstractItemView::item {
	height: 21px;
	border-radius: 4px;
	padding: 0px 2px;
	color: palette(window-text);
}

QListView::item:hover,
QComboBox QAbstractItemView::item:hover {
    background-color: transparent;
}

QListView::item:selected,
QComboBox QAbstractItemView::item:selected {
	background-color: palette(highlight);
    color: palette(highlighted-text);
}

QListView::item:selected:!active {
    background-color: palette(midlight);
    color: palette(text);
}
/* =================== QListView  End  =================== */




/* =================== QSplitter Begin =================== */
QSplitter::handle {
    background-color: palette(midlight);
    margin: 0px;
    width: 1px;
    height: 1px;
}

QSplitter[collapsed="true"]::handle {
    background-color: palette(base);
    border: none;
    outline: none;
    image: none;
}

QSplitter[collapsed="true"]::handle:hover {
    background-color: palette(link);
}

/* =================== QSplitter  End  =================== */




/* =================== App Begin =================== */
MainWindow {
    background-color: palette(window);
}

QSplitter#RootSplitter {
    border-top: 1px solid palette(midlight);
    border-bottom: 1px solid palette(midlight);
}
/* =================== App  End  =================== */




/* =================== Dialog Begin =================== */
QDialog {
    background-color: palette(window);
}
/* =================== Dialog End =================== */




/* =================== QTabWidget Begin =================== */
QTabWidget::pane {
    border: none;
    border-top: 1px solid palette(mid);
    top: -1px;
}

QTabBar::tab {
    height: 20px;
    padding: 3px 4px;
    border: none;
    border-bottom: 2px solid transparent;
    background-color: palette(window);
    color: palette(window-text);
    background-clip: padding;
}

QTabBar::tab:selected {
    border-bottom-color: palette(highlight);
}

QTabBar::tab:disabled {
    color: palette(dark);
}
/* =================== QTabWidget End =================== */




/* =================== QToolTip Begin =================== */
QToolTip {
    color: palette(window-text);
    padding: 2px;
    background-color: palette(base);
    border: 1px solid palette(mid);
    outline: none;
    border-radius: 4px;
}
/* =================== QToolTip  End  =================== */




/* =================== QComboBox Begin =================== */
/* 输入控件共用主题颜色；禁用时 Light / Midlight / Dark 分别提供背景、边框和文字。 */
QComboBox,
QLineEdit,
QTextEdit {
    border: 1px solid palette(mid);
    border-radius: 4px;
    background-color: palette(base);
    color: palette(text);
}

QComboBox:enabled:focus,
QComboBox:enabled:on,
QLineEdit:enabled:focus,
QSpinBox:enabled:focus,
QTextEdit:enabled:focus {
    border-color: palette(link-visited);
}

QComboBox:disabled,
QLineEdit:disabled,
QTextEdit:disabled {
    background-color: palette(light);
    border-color: palette(midlight);
    color: palette(dark);
}

QComboBox {
    height: 20px;
    min-height: 20px;
    max-height: 20px;
    padding: 0px 6px;
    combobox-popup: 0;
}

/* 右侧下拉按钮 */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right center;
    width: 20px;
    border: none;
    border-left: 1px solid palette(mid);
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QComboBox::drop-down:hover {
    /* background-color: #EDEDED; */
}

QComboBox::drop-down:disabled {
    border-left-color: palette(midlight);
}

/* 下拉箭头图标，复用已有的 chevronDown */
QComboBox::down-arrow {
    image: url(:/icons/chevronDown.svg);
}

QComboBox::down-arrow:disabled {
    opacity: 0.4;
}

QComboBox QAbstractItemView {
    border: none;
}
/* =================== QComboBox  End  =================== */




/* =================== QTextBrowser Begin =================== */
QTextBrowser {
    border: none;
}
/* =================== QTextBrowser  End  =================== */




/* =================== QToolBar Begin =================== */
QToolBar {
	padding: 2px;
	margin: 0;
	border: none;
	outline: none;
	spacing: 4px;
}

QToolButton {
    border: none;
    outline: none;
    border-radius: 4px;
    background-color: transparent;
}

/* 浅灰工具按钮反馈，叠加在主题背景上。 */
QToolButton:enabled:hover {
    background-color: rgba(0, 0, 0, 18);
}

QToolButton:enabled:pressed,
QToolButton:enabled:checked {
    background-color: rgba(0, 0, 0, 29);
}
/* =================== QToolBar  End  =================== */




/* =================== QPushButton Begin =================== */
QPushButton {
    min-width: 46px;
    height: 16px;
    padding: 2px 6px;
    border: 1px solid palette(mid);
    border-radius: 4px;
    background-color: palette(button);
    color: palette(button-text);
    outline: none;
}

QPushButton:enabled:hover {
    background-color: #F7F7F7;
    border-color: palette(link-visited);
}

QPushButton:enabled:pressed {
    background-color: palette(alternate-base);
    border-color: palette(shadow);
}

QPushButton:enabled:checked {
    background-color: palette(midlight);
    border-color: palette(link-visited);
}

/* Focus changes only the border color, keeping its width at 1px. */
QPushButton:enabled:focus {
    border-color: palette(link-visited);
}

/* 默认按钮和 primary=true 使用强调边框，保持按钮整体尺寸一致。 */
QPushButton:default,
QPushButton[primary="true"] {
    background-color: palette(button);
    border: 1px solid palette(link);
    color: palette(button-text);
}

QPushButton:default:enabled:hover,
QPushButton[primary="true"]:enabled:hover {
    background-color: #F7F7F7;
    border-color: palette(link-visited);
}

QPushButton:default:enabled:pressed,
QPushButton:default:enabled:checked,
QPushButton[primary="true"]:enabled:pressed,
QPushButton[primary="true"]:enabled:checked {
    background-color: palette(alternate-base);
    border-color: palette(link-visited);
}

QPushButton:default:enabled:focus,
QPushButton[primary="true"]:enabled:focus {
    border-color: palette(link-visited);
}

QPushButton:disabled,
QPushButton:default:disabled,
QPushButton[primary="true"]:disabled {
    background-color: palette(light);
    border-color: palette(midlight);
    color: palette(dark);
}
/* =================== QPushButton  End  =================== */




/* =================== QCheckBox Begin =================== */
QCheckBox {
    spacing: 3px;
    background: transparent;
    outline: none;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid palette(mid); 
    border-radius: 3px;
    background-color: palette(base);
    image: none;
	subcontrol-origin: content;
	subcontrol-position: center left;
	top: 0px;
}

QCheckBox::indicator:checked {
    background-color: palette(highlight);
    border-color: palette(highlight);
    image: url(:/icons/checked-white.svg);
}

QCheckBox:disabled {
    color: palette(dark);
}

QCheckBox::indicator:disabled {
    background-color: palette(light);
    border-color: palette(midlight);
}

QCheckBox::indicator:checked:disabled {
    image: url(:/icons/checked-disabled.svg);
}
/* =================== QCheckBox  End  =================== */


/* =================== QRadioButton Begin =================== */
QRadioButton {
    spacing: 6px;
    background: transparent;
}

/* 圆环和圆点由 RadioButton 抗锯齿绘制，QSS 统一控制尺寸与文字间距。 */
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: none;
    background: transparent;
}
/* =================== QRadioButton  End  =================== */




/* =================== QTextEdit Begin =================== */
QTextEdit {
    padding: 0px;
}
/* =================== QTextEdit  End  =================== */





/* =================== QLineEdit Begin =================== */
QLineEdit {
    padding: 0px 4px;
    min-height: 20px;
    max-height: 20px;
}

/* 组合控件内部的编辑框共用外层边框，避免出现双层边框。 */
QComboBox QLineEdit,
QAbstractSpinBox QLineEdit,
QComboBox QLineEdit:disabled,
QAbstractSpinBox QLineEdit:disabled {
    border: none;
    border-radius: 0px;
    padding: 0px;
    background-color: transparent;
    min-height: 0px;
    max-height: 16777215px;
}
/* =================== QLineEdit  End  =================== */




/* =================== QSpinBox Begin =================== */
QSpinBox {
    min-height: 20px;
    max-height: 20px;
    padding: 0px 24px 0px 4px;
    border: 1px solid palette(mid);
    border-radius: 4px;
    background-color: palette(base);
    color: palette(text);
}

QSpinBox:disabled {
    background-color: palette(light);
    border-color: palette(midlight);
    color: palette(dark);
}

QSpinBox::up-button,
QSpinBox::down-button {
    subcontrol-origin: padding;
    width: 20px;
    border: none;
    border-left: 1px solid palette(mid);
    background-color: transparent;
}

QSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 3px;
}

QSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 3px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background-color: transparent;
}

QSpinBox::up-button:pressed,
QSpinBox::down-button:pressed {
    background-color: rgba(0, 0, 0, 29);
}

QSpinBox::up-button:off,
QSpinBox::down-button:off,
QSpinBox::up-button:disabled,
QSpinBox::down-button:disabled {
    background-color: transparent;
}

QSpinBox::up-button:disabled,
QSpinBox::down-button:disabled {
    border-left-color: palette(midlight);
}

QSpinBox::up-arrow,
QSpinBox::down-arrow {
    width: 16px;
    height: 16px;
}

QSpinBox::up-arrow {
    position: relative;
    top: 1px;
    image: url(:/icons/chevronUp.svg);
}

QSpinBox::down-arrow {
    position: relative;
    bottom: 1px;
    image: url(:/icons/chevronDown.svg);
}

QSpinBox::up-arrow:disabled,
QSpinBox::up-arrow:off {
    image: url(:/icons/chevronUp-disabled.svg);
}

QSpinBox::down-arrow:disabled,
QSpinBox::down-arrow:off {
    image: url(:/icons/chevronDown-disabled.svg);
}
/* =================== QSpinBox  End  =================== */




/* =================== QGroupBox  End  =================== */
QGroupBox {
    border: 1px solid palette(mid);
    border-radius: 4px;
    margin-top: 0.5em;
    padding: 10px 4px 4px 4px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0px 4px;
    background-color: palette(window);
    color: palette(window-text);
}
/* =================== QGroupBox  End  =================== */
